# Local service URLs
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
PREFECT_API_URL=http://127.0.0.1:4200/api

# Model registry defaults
MLFLOW_EXPERIMENT_NAME=green-taxi-duration
MLFLOW_MODEL_NAME=green-taxi-duration

# Optional model selection overrides.
# Leave these blank on the first pass so the repo resolves the newest registered version.
MODEL_URI=
MODEL_ALIAS=
MODEL_STAGE=
MODEL_VERSION=
MODEL_RUN_ID=
MODEL_ARTIFACT_PATH=model

# Dataset and output locations
# The datasets stay remote to keep this teaching repo lightweight; only the services run locally.
TRAIN_DATA_URI=https://d37ci6vzurychx.cloudfront.net/trip-data/green_tripdata_2023-01.parquet
BATCH_INPUT_URI=https://d37ci6vzurychx.cloudfront.net/trip-data/green_tripdata_2023-02.parquet
BATCH_OUTPUT_DIR=data/predictions
MLFLOW_ARTIFACTS_DIR=storage/mlartifacts

# Prefect schedule used by `python -m src.batch.serve`
# This example runs at 06:00 UTC on the first day of each month.
BATCH_CRON=0 6 1 * *
